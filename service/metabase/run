#!/bin/sh
exec 2>&1

# chpst -e reads the files in /env_vars as names of environment variables with value the content of the file
# and pass this environment to the command. However, this environment only applies to the subproccess spawned
# by the command, so JAVA_OPTS is not set in the command itself, we must set it explicitly
JAVA_OPTS=$(cat /env_vars/JAVA_OPTS)
chpst -e /env_vars java $JAVA_OPTS -jar /app/target/uberjar/metabase.jar
