#!/bin/bash -e

source /usr/local/lib/b-log.sh

DOCKER_LOG_LEVEL=${DOCKER_LOG_LEVEL:-INFO}
eval LOG_LEVEL_${DOCKER_LOG_LEVEL}
B_LOG --stdout true # enable logging over stdout

# Datio compatibility
if [[ "$TENANT_NAME" != "" ]]; then
  export DISCOVERY_INSTANCE_NAME="$TENANT_NAME"
fi

DOWNLOAD_SECRETS=${DOWNLOAD_SECRETS:-"true"}

# set up env variables that oauth-base rc.local uses to download secrets
# in previous versions SECRET_NAME was called CONV_MARATHON_APP_ID
SECRET_NAME=$DISCOVERY_INSTANCE_NAME
OAUTH_COOKIE_PREFIX=${DISCOVERY_INSTANCE_NAME:-$OAUTH_COOKIE_PREFIX}
export OAUTH_COOKIE_PREFIX
export SECRET_NAME

# for retrocompatibility keep checking some environment variables
if [ "$USE_GOSEC_SSO_AUTH" = "true" ]; then
    WARN "USE_GOSEC_SSO_AUTH env. variable is deprecated, please use AUTHENTICATOR=gosec-sso"
    AUTHENTICATOR="gosec-sso"
fi

# this configures the rc.local of oauth-base to not use dcos oauth
# TODO: maybe we can stop using oauthbase image since we do no longer make the oauth
export JWT_VALIDATION_DISABLED="true"

if [ "$DOWNLOAD_SECRETS" = "true" ]; then
  source /etc/rc.local.base
else
  source /docker-entrypoint.sh
fi
