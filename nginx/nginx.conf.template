worker_processes  $NGINX_WORKER_PROCESSES;

error_log /dev/stderr $NGINX_ERROR_LOG_LEVEL;

events {
    worker_connections $NGINX_EVENT_CONNECTIONS;
}

http {

    # set uid variable from header "Metabse-User" set in response by stratio metabase middleware
    # (using "-" instead of "" if no header is prsent) so that we can use it in the access log
    map $upstream_http_metabase_user $uid {
        ""      "-";
        default $upstream_http_metabase_user;
    }

    log_format main '$time_iso8601 AUDIT $uid 1 nginx access_log'
                    ' {"@message":"$remote_addr - $remote_user [$time_local] $request'
                    ' $status $body_bytes_sent $http_referer $http_user_agent $http_x_forwarded_for"}';

    access_log /dev/stdout main;

    server {
        listen 443 ssl;
        ssl_certificate     /etc/pki/discovery.pem;
        ssl_certificate_key /etc/pki/discovery.key;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_read_timeout ${PROXY_READ_TIMEOUT}s;
        }

        location /discovery-cicd {
            client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
            proxy_read_timeout ${PROXY_READ_TIMEOUT}s;
            # nginx talks HTTP/1.0 upstream by default, and an import arrives here with a chunked
            # body, which akka http rejects outright: "HTTP/1.0 requests must not have a chunked
            # entity". Only requests that come through this proxy are affected, so an import run
            # from inside the pod against 127.0.0.1:8087 never showed it
            proxy_http_version 1.1;
            proxy_pass http://127.0.0.1:8087;
        }
    }

    # TODO: remove this and go through the 443 server above
    # This server is needed for health check purposes
    server {
        listen 3009;

        location "/api/health" {
            proxy_pass http://127.0.0.1:3000;
        }
    }

}
